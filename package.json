{
  "name": "chinese2english",
  "version": "0.1.0",
  "description": "Universal English translation patch for DeepSeek Harness third-party plugins",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "translation",
    "english",
    "i18n",
    "localization"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "patch": "python3 patch-plugins.py",
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.oiupoyt.space/oiupoyt/chinese2english.git"
  },
  "bugs": {
    "url": "https://git.oiupoyt.space/oiupoyt/chinese2english/issues"
  },
  "homepage": "https://git.oiupoyt.space/oiupoyt/chinese2english#readme"
}
